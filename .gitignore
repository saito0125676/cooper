# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Stripe CLI binary (ダウンロードして各自のローカルに置く開発ツールのため)
/stripe.exe

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ただし秘密情報を含まない「ひな形」ファイルはリポジトリに含める
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# AIコーディングツール向けのローカル設定/スキル資料(プロジェクト本体ではないため除外)
/.claude/
/.agents/
/.windsurf/
skills-lock.json
