# ローカルPostgres (docker-compose up -d で起動)
DATABASE_URL="postgresql://rentalcar:rentalcar@localhost:5432/rentalcar"

# Stripeダッシュボード > 開発者 > APIキー から取得 (テストモードのキーを使うこと)
STRIPE_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_OWN_KEY"

# Stripe CLI (stripe listen) or ダッシュボードのWebhook設定画面から取得する署名シークレット
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_YOUR_OWN_SECRET"

# Checkout完了後/キャンセル後に戻ってくるURL(デモではローカル開発サーバーを想定)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 仮押さえ失効バッチ(/api/cron/expire-holds)を外部から叩く際の認証トークン
CRON_SECRET="change-me-to-a-random-string"
